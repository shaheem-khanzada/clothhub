# Copy to apps/api/.env for local development. Real values for staging and
# production live in Coolify's environment settings, never in git.

# ClothHub's own database (docker compose default)
DATABASE_URL=postgres://clothhub:clothhub@localhost:5432/clothhub

# Read-only connection to the scraper's MySQL database — used only by the ingest job
# mysql://USER:PASSWORD@HOST:3306/DATABASE
SCRAPER_DATABASE_URL=

PORT=3000
LOG_LEVEL=info

# Copy to apps/api/.env for local development. Real values for the dev and
# production servers live in Coolify's environment settings, never in git.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ClothHub's own database (docker compose default)
DATABASE_URL=mysql://clothhub:clothhub@127.0.0.1:3306/clothhub_dev

# Read-only connection to the scraper's MySQL database — used only by the
# ingest job. Locally: a dump loaded with scripts/load-scraper-dump.sh.
SCRAPER_DATABASE_URL=mysql://clothhub_reader:reader@127.0.0.1:3306/scraper

# Sign-in (Better Auth). The secret signs session cookies: generate one with
# `openssl rand -base64 32` (a different one per environment). BETTER_AUTH_URL
# is the API's public address as the app reaches it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google and Apple sign-in stay off until all of their values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 key, BEGIN/END lines included, multi-line inside double quotes.
APPLE_PRIVATE_KEY=
# APPLE_APP_BUNDLE_ID=com.clothhub.digital

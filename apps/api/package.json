{
  "name": "@clothhub/api",
  "version": "0.0.0",
  "private": true,
  "description": "ClothHub REST API: Hono + Zod + Drizzle on MySQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "ingest": "tsx --env-file-if-exists=.env src/jobs/ingest/index.ts",
    "placeholders": "tsx --env-file-if-exists=.env src/jobs/placeholders/index.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@clothhub/shared": "*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}

{
  "expo": {
    "name": "ClothHub",
    "slug": "clothhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clothhub",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "bundleIdentifier": "com.clothhub.digital",
      "supportsTablet": false,
      "icon": "./assets/images/clothhub.icon",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.clothhub.digital",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0C",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque-Regular.ttf",
            "./assets/fonts/BricolageGrotesque-Medium.ttf",
            "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
            "./assets/fonts/BricolageGrotesque-Bold.ttf",
            "./assets/fonts/BricolageGrotesque-DisplaySemiBold.ttf",
            "./assets/fonts/BricolageGrotesque-DisplayBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2958115c-b524-4df9-8195-4c0af1ee851d"
      }
    },
    "owner": "shaheemkz"
  }
}

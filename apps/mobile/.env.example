# Copy to `.env.local` (git-ignored) and point it at an API:
#
#   iOS simulator          http://localhost:3000
#   Android emulator       http://10.0.2.2:3000
#   Phone on your Wi-Fi    http://<your Mac's LAN IP>:3000   (System Settings → Wi-Fi → Details)
#   Development server     https://<dev API domain on Coolify>
#
# Restart Metro after changing it (`npx expo start -c`).
EXPO_PUBLIC_API_URL=http://localhost:3000
